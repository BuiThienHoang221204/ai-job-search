# --- Database ---
DATABASE_URL="postgresql://aijob:aijob_dev_password@localhost:5432/aijob?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Đổi giá trị này trước khi deploy. Sinh bằng: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-truoc-khi-deploy
JWT_EXPIRES_IN=7d

# --- AI ---
# Loi mac dinh. Cac loi he thong biet duoc khai o src/modules/ai/providers/.
MODEL_PROVIDER=opencode
MODEL_ID=mimo-v2.5-free
# Cac mat xich thu tiep khi mat xich dang dung KHONG CHAY DUOC.
#
# Can thiet vi han muc cua gateway free tinh THEO TUNG MODEL, khong theo API key:
# do cung mot thoi diem, deepseek va mimo tra 429 trong khi nemotron va hy3 van chay.
#
# Viet "loi/model" de nhay sang loi khac, hoac chi "model" cho loi mac dinh.
# Tach o dau / DAU TIEN, nen model id cua OpenRouter (von co dau /) van viet duoc:
#   openrouter/openai/gpt-oss-20b:free
#
# Thu tu theo chat luong da do; bo trong de tat hoan toan.
#
# Chuoi mac dinh trai qua CA BA be han muc doc lap: opencode (key "public" dung
# chung voi nguoi la), openrouter (key rieng cua ban), kilo (khong can key).
#
# Da BO nemotron-3.5-lightning-free khoi chuoi: do duoc no het gio tren prompt
# that o ca moc 90s lan 240s, du prompt nho thi xong trong 12,4 giay.
MODEL_FALLBACK_IDS=deepseek-v4-flash-free,hy3-free,mimo-v2.5-free,openrouter/nvidia/nemotron-3-super-120b-a12b:free,kilo/tencent/hy3:free

# Key cua loi opencode. Gateway cong khai chap nhan "public" cho cac model free.
AI_API_KEY=public

# User-Agent gui kem moi request toi loi opencode. BO TRONG = tat.
OPENCODE_USER_AGENT=
# Key cua loi openrouter. Bo trong = loi nay bi bo qua trong chuoi du phong.
# Model :free cua OpenRouter VAN doi key.
OPENROUTER_API_KEY=

# Loi kilo KHONG can key (da do: khong header van tra 200). De trong la duoc.
# CANH BAO: ca 14 model free cua kilo deu tu khai mayTrainOnYourPrompts=true,
# nen day la mat xich CUOI chuoi, khong phai loi chinh. Doc docblock kilo.ts.
KILO_API_KEY=

# Cho phep chuoi cham model TRA TIEN. Mac dinh tat.
# Bat cai nay la mo duong cho mot hoa don chay theo cron - doc docblock trong
# configuration.ts truoc khi doi.
AI_ALLOW_PAID_MODELS=false

OPENCODE_MODELS_URL=https://models.opencode.ai/api.json

# --- Skills ---
# Đường dẫn TUYỆT ĐỐI tới thư mục skill gốc của repo.
# Bắt buộc phải trỏ ra root, KHÔNG được để runtime tự tìm ".claude" gần nhất:
# server/.claude/skills/ chứa skill của Prisma CLI, không phải skill nghiệp vụ.
SKILLS_DIR=../.claude/skills

# --- Storage ---
# local: ghi xuống ổ đĩa. Đổi sang s3 khi lên cloud, không sửa logic nào khác.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../workspaces

# --- Scraper ---
# Hạn thời gian cho một lần gọi CLI portal (fetch + parse).
SCRAPER_TIMEOUT_MS=60000

# Thư mục chứa portal CLI. Quét động lúc khởi động: mỗi thư mục con có SKILL.md
# và cli/src/cli.ts sẽ thành một portal. Tắt một portal bằng cách đặt
# `enabled: false` trong SKILL.md của nó, không cần sửa code.
PORTALS_DIR=../.agents/skills

# Nghỉ giữa hai lần gọi cùng một portal. Không portal nào khai Crawl-delay
# trong robots.txt, nên phải tự đặt nhịp. Bắn liên tiếp là cách nhanh nhất để
# bị chặn IP máy chủ - mà mất IP là mất cả sản phẩm, không chỉ mất một lần quét.
SCRAPER_PORTAL_DELAY_MS=3000

# Địa điểm mặc định khi hồ sơ chưa khai. LinkedIn BẮT BUỘC có --location.
SCRAPER_DEFAULT_LOCATION=Vietnam

# --- Cron quét tin hằng đêm ---
# Đặt false khi chạy máy cục bộ, để không gọi vào portal mỗi lần mở máy.
SCRAPE_CRON_ENABLED=true

# Cron 5 trường. Mặc định 23:00 hằng ngày.
SCRAPE_CRON_SCHEDULE=0 23 * * *

# BẮT BUỘC khai tường minh. Máy chủ thường chạy UTC, và "0 23 * * *" theo UTC
# là 6 giờ sáng hôm sau ở Việt Nam.
CRON_TIMEZONE=Asia/Ho_Chi_Minh

# Database riêng cho test tích hợp (pnpm test:e2e). Tên PHẢI kết thúc
# bằng _test: bộ khung test TRUNCATE mọi bảng trong database nó trỏ tới.
TEST_DATABASE_URL="postgresql://aijob:aijob_dev_password@localhost:5432/aijob_test?schema=public"

# Chỉ bật MỘT LẦN khi nâng cấp một database đã chạy từ trước: pg-boss không đổi
# được policy của hàng đợi tại chỗ, nên bước nâng cấp phải xoá và tạo lại hàng
# đợi, và việc đang chờ trong đó sẽ mất. Để trống trong mọi trường hợp khác.
# QUEUE_POLICY_MIGRATE=true

# Nhặt lại việc nền đã rơi (bản ghi ở PENDING/RUNNING quá lâu mà không có message
# nào trong hàng đợi). Bật theo mặc định - tắt đi thì một message bị mất sẽ để
# người dùng nhìn "đang sinh..." vĩnh viễn mà không ai biết.
# RECONCILE_CRON_ENABLED=false
# RECONCILE_CRON_SCHEDULE="*/10 * * * *"

# Rate limiting. Trần chung theo IP; các route tốn kém (gọi model, đăng nhập,
# quét portal) có trần riêng chặt hơn khai ngay trong code - xem src/common/throttle.ts.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
#
# CHỈ dùng cho test tích hợp. Đặt true ở production là gỡ bỏ toàn bộ rate limiting.
# THROTTLE_DISABLED=true

# --- Tao PDF ---
# URL cua dich vu compile LaTeX. Co gia tri -> goi dich vu qua HTTP (production).
# Bo trong -> app tu goi `docker run` (may phat trien, app chay truc tiep tren host).
#
# Chay dich vu bang compose:
#   docker build -t aijob-latex -f ../latex-service/Dockerfile ../latex-service
#   docker compose up -d latex
# Khi app cung chay trong compose thi dat LATEX_SERVICE_URL=http://latex:8080
LATEX_SERVICE_URL=
